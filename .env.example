# Timing provider (confirm endpoint and response schema before use)
TIMING_API_URL=
TIMING_API_TOKEN=

# Google Cloud project and BigQuery destination
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=marathon
BQ_LOCATION=US

# Optional: archive each fetched source response as JSON in this bucket.
# Bucket must already exist and the active identity must have write access.
GCS_RAW_BUCKET=

# Local development only: use Application Default Credentials instead of a key file.
# gcloud auth application-default login
